PORT=3000
DATA_DIR=./data
# Vor dem ersten Start einen eigenen langen, zufälligen Setup-Code setzen.
EVIDENCE_SETUP_TOKEN=
# Nur für HTTPS-Hosting. Für lokale HTTP-Tests leer lassen.
APP_ORIGIN=
# Vercel: persistente externe libSQL-Datenbank erforderlich
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional fixed database connection; set BOTH values to override integration-managed Turso variables.
EVIDENCE_DATABASE_URL=
EVIDENCE_DATABASE_AUTH_TOKEN=
# Optional: aktiviert generative Antworten und zweite KI-Prüfung
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODEL_PRUEFER=gpt-4.1-mini

# Lokales Modell als Alternative zu OpenAI. Der Modellname aktiviert Ollama.
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
