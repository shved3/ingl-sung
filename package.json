{
  "name": "evidence-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/start.js",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.mjs",
    "build:client": "esbuild client/main.jsx --bundle --minify --format=esm --legal-comments=linked --outfile=public/app.js"
  },
  "devDependencies": {
    "esbuild": "0.28.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "dependencies": {
    "@azure/msal-browser": "4.26.0",
    "@simplewebauthn/browser": "13.2.2",
    "@simplewebauthn/server": "13.2.2",
    "@tesseract.js-data/deu": "1.0.0",
    "mammoth": "1.10.0",
    "tesseract.js": "6.0.1",
    "word-extractor": "1.0.4",
    "xlsx": "0.18.5"
  }
}
